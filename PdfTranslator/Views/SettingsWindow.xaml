<Window x:Class="PdfTranslator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" 
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="16" CornerRadius="3" Margin="0,0,0,20">
            <TextBlock Text="API Settings" 
                       FontSize="24" FontWeight="Medium"
                       Foreground="White"/>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- DeepL Settings -->
                <Border Background="White" Padding="20" CornerRadius="3" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="DeepL API" 
                                   FontSize="18" FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="API Key" 
                                   FontWeight="Medium"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="DeepLApiKeyTextBox"
                                 Padding="8"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 Margin="0,0,0,10"/>

                        <TextBlock TextWrapping="Wrap" 
                                   Foreground="#666666"
                                   FontSize="12">
                            Get your free API key from https://www.deepl.com/pro-api
                            <LineBreak/>
                            Free tier: 500,000 characters/month
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Microsoft Translator Settings -->
                <Border Background="White" Padding="20" CornerRadius="3" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Microsoft Translator" 
                                   FontSize="18" FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="API Key" 
                                   FontWeight="Medium"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="MicrosoftApiKeyTextBox"
                                 Padding="8"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 Margin="0,0,0,5"/>

                        <TextBlock Text="Region" 
                                   FontWeight="Medium"
                                   Margin="0,10,0,5"/>
                        <TextBox x:Name="MicrosoftRegionTextBox"
                                 Padding="8"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 Margin="0,0,0,10"/>

                        <TextBlock TextWrapping="Wrap" 
                                   Foreground="#666666"
                                   FontSize="12">
                            Create a Translator resource in Azure Portal: https://portal.azure.com
                            <LineBreak/>
                            Free tier: 2M characters/month
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Google Cloud Translation Settings -->
                <Border Background="White" Padding="20" CornerRadius="3" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Google Cloud Translation" 
                                   FontSize="18" FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Service Account JSON File Path" 
                                   FontWeight="Medium"
                                   Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GoogleCredentialsPathTextBox"
                                     Grid.Column="0"
                                     Padding="8"
                                     BorderBrush="#CCCCCC"
                                     BorderThickness="1"
                                     Margin="0,0,5,0"/>
                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Click="BrowseGoogleCredentials_Click"
                                    Padding="10,8"
                                    Background="#2196F3"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="Project ID" 
                                   FontWeight="Medium"
                                   Margin="0,10,0,5"/>
                        <TextBox x:Name="GoogleProjectIdTextBox"
                                 Padding="8"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 Margin="0,0,0,10"/>

                        <TextBlock TextWrapping="Wrap" 
                                   Foreground="#666666"
                                   FontSize="12">
                            1. Go to Google Cloud Console: https://console.cloud.google.com
                            <LineBreak/>
                            2. Enable Cloud Translation API
                            <LineBreak/>
                            3. Create a Service Account and download the JSON key file
                            <LineBreak/>
                            Free tier: 500,000 characters/month
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Azure Document Intelligence Settings -->
                <Border Background="White" Padding="20" CornerRadius="3" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Azure Document Intelligence (OCR)" 
                                   FontSize="18" FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Endpoint" 
                                   FontWeight="Medium"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="AzureDocIntelEndpointTextBox"
                                 Padding="8"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 Margin="0,0,0,5"/>

                        <TextBlock Text="API Key" 
                                   FontWeight="Medium"
                                   Margin="0,10,0,5"/>
                        <TextBox x:Name="AzureDocIntelApiKeyTextBox"
                                 Padding="8"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 Margin="0,0,0,10"/>

                        <TextBlock TextWrapping="Wrap" 
                                   Foreground="#666666"
                                   FontSize="12">
                            Create a Document Intelligence resource: https://portal.azure.com
                            <LineBreak/>
                            Free tier: 500 pages/month
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Tesseract Info -->
                <Border Background="White" Padding="20" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="Tesseract OCR" 
                                   FontSize="18" FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <TextBlock TextWrapping="Wrap" 
                                   Foreground="#666666">
                            Tesseract is completely free and requires no API key.
                            <LineBreak/><LineBreak/>
                            To enable Russian language support, download the rus.traineddata file from:
                            <LineBreak/>
                            https://github.com/tesseract-ocr/tessdata
                            <LineBreak/><LineBreak/>
                            Place it in: %APPDATA%\PdfTranslator\tessdata\
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Save"
                    Click="SaveButton_Click"
                    Padding="20,10"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="2"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Padding="20,10"
                    Background="#757575"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
