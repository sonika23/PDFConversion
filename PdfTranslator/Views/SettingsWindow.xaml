<Window x:Class="PdfTranslator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" 
        Height="850" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="CanResize"
        MinHeight="600" MinWidth="650">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="16" CornerRadius="3" Margin="0,0,0,20">
            <TextBlock Text="API Settings" 
                       FontSize="24" FontWeight="Medium"
                       Foreground="White"/>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- ==================== DEEPL SETTINGS ==================== -->
                <Border Background="White" Padding="20" CornerRadius="3" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="DeepL API" 
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,15"/>
                        
                        <!-- DeepL Free Account -->
                        <Border Background="#E3F2FD" Padding="15" CornerRadius="3" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Free Account" 
                                           FontWeight="SemiBold"
                                           Foreground="#1565C0"
                                           Margin="0,0,0,8"/>
                                
                                <TextBlock Text="API Key (Free)" 
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="DeepLFreeApiKeyTextBox"
                                         Padding="8"
                                         BorderBrush="#90CAF9"
                                         BorderThickness="1"/>
                                
                                <TextBlock Text="Limited to 500,000 characters/month"
                                           Foreground="#666666"
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- DeepL Pro Account -->
                        <Border Background="#E8F5E9" Padding="15" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="Pro Account" 
                                           FontWeight="SemiBold"
                                           Foreground="#2E7D32"
                                           Margin="0,0,0,8"/>
                                
                                <TextBlock Text="API Key (Pro)" 
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="DeepLPaidApiKeyTextBox"
                                         Padding="8"
                                         BorderBrush="#A5D6A7"
                                         BorderThickness="1"/>
                                
                                <TextBlock Text="Unlimited characters (pay per use), Document translation available"
                                           Foreground="#666666"
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <TextBlock TextWrapping="Wrap" 
                                   Foreground="#666666"
                                   FontSize="12"
                                   Margin="0,10,0,0">
                            Get your API key from: https://www.deepl.com/pro-api
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ==================== MICROSOFT TRANSLATOR SETTINGS ==================== -->
                <Border Background="White" Padding="20" CornerRadius="3" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Microsoft Translator" 
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,15"/>
                        
                        <!-- Microsoft Free Account (F0) -->
                        <Border Background="#E3F2FD" Padding="15" CornerRadius="3" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Free Account (F0 Tier) - Text API Only" 
                                           FontWeight="SemiBold"
                                           Foreground="#1565C0"
                                           Margin="0,0,0,8"/>
                                
                                <TextBlock Text="API Key" 
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="MicrosoftFreeApiKeyTextBox"
                                         Padding="8"
                                         BorderBrush="#90CAF9"
                                         BorderThickness="1"
                                         Margin="0,0,0,8"/>
                                
                                <TextBlock Text="Region" 
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="MicrosoftFreeRegionTextBox"
                                         Padding="8"
                                         BorderBrush="#90CAF9"
                                         BorderThickness="1"
                                         Text="global"/>
                                
                                <TextBlock Text="2M characters/month free. Uses Text Translation API with overlay method."
                                           Foreground="#666666"
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Microsoft Paid Account (S1) -->
                        <Border Background="#E8F5E9" Padding="15" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="Paid Account (S1 Tier) - Document Translation API" 
                                           FontWeight="SemiBold"
                                           Foreground="#2E7D32"
                                           Margin="0,0,0,8"/>
                                
                                <TextBlock Text="API Key" 
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="MicrosoftPaidApiKeyTextBox"
                                         Padding="8"
                                         BorderBrush="#A5D6A7"
                                         BorderThickness="1"
                                         Margin="0,0,0,8"/>
                                
                                <TextBlock Text="Endpoint" 
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="MicrosoftPaidEndpointTextBox"
                                         Padding="8"
                                         BorderBrush="#A5D6A7"
                                         BorderThickness="1"
                                         Margin="0,0,0,8"/>
                                
                                <TextBlock Text="Azure Storage Connection String" 
                                           FontWeight="Medium"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="MicrosoftPaidStorageConnectionStringTextBox"
                                         Padding="8"
                                         BorderBrush="#A5D6A7"
                                         BorderThickness="1"/>
                                
                                <TextBlock Text="Full Document Translation with OCR support. Preserves PDF formatting."
                                           Foreground="#666666"
                                           FontSize="11"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <Button x:Name="TestMicrosoftConnectionButton"
                                Content="Test Microsoft Connection"
                                Click="TestMicrosoftConnection_Click"
                                Padding="10,8"
                                Background="#2196F3"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,10,0,0"/>
                        
                        <TextBlock TextWrapping="Wrap" 
                                   Foreground="#666666"
                                   FontSize="12"
                                   Margin="0,10,0,0">
                            Create resources in Azure Portal: https://portal.azure.com
                            <LineBreak/>
                            Endpoint example: https://your-translator.cognitiveservices.azure.com/
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Google Cloud Settings - Hidden due to reliability issues -->
                <Border Background="White" Padding="20" CornerRadius="3" Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Google Cloud Translation" 
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Service Account JSON File Path" 
                                   FontWeight="Medium"
                                   Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GoogleCredentialsPathTextBox"
                                     Grid.Column="0"
                                     Padding="8"
                                     BorderBrush="#CCCCCC"
                                     BorderThickness="1"
                                     Margin="0,0,5,0"/>
                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Click="BrowseGoogleCredentials_Click"
                                    Padding="10,8"
                                    Background="#2196F3"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="Project ID" 
                                   FontWeight="Medium"
                                   Margin="0,10,0,5"/>
                        <TextBox x:Name="GoogleProjectIdTextBox"
                                 Padding="8"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 Margin="0,0,0,10"/>

                        <TextBlock TextWrapping="Wrap" 
                                   Foreground="#666666"
                                   FontSize="12">
                            1. Go to Google Cloud Console: https://console.cloud.google.com
                            <LineBreak/>
                            2. Enable Cloud Translation API
                            <LineBreak/>
                            3. Create a Service Account and download the JSON key file
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ==================== AZURE DOCUMENT INTELLIGENCE ==================== -->
                <Border Background="White" Padding="20" CornerRadius="3" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Azure Document Intelligence (OCR)" 
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Endpoint" 
                                   FontWeight="Medium"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="AzureDocIntelEndpointTextBox"
                                 Padding="8"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 Margin="0,0,0,5"/>

                        <TextBlock Text="API Key" 
                                   FontWeight="Medium"
                                   Margin="0,10,0,5"/>
                        <TextBox x:Name="AzureDocIntelApiKeyTextBox"
                                 Padding="8"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 Margin="0,0,0,10"/>

                        <TextBlock TextWrapping="Wrap" 
                                   Foreground="#666666"
                                   FontSize="12">
                            Create a Document Intelligence resource: https://portal.azure.com
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ==================== TESSERACT INFO ==================== -->
                <Border Background="White" Padding="20" CornerRadius="3" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Tesseract OCR" 
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#1976D2"
                                   Margin="0,0,0,10"/>

                        <TextBlock TextWrapping="Wrap" 
                                   Foreground="#666666">
                            Tesseract is completely free and requires no API key.
                            <LineBreak/><LineBreak/>
                            To enable Russian language support, download the rus.traineddata file from:
                            <LineBreak/>
                            https://github.com/tesseract-ocr/tessdata
                            <LineBreak/><LineBreak/>
                            Place it in: %APPDATA%\PdfTranslator\tessdata\
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- PDF Generator Engine - Hidden, defaulting to PdfPig -->
                <Border Background="White" Padding="20" CornerRadius="3" Visibility="Collapsed">
                    <StackPanel>
                        <RadioButton x:Name="PdfPigRadio" IsChecked="True" Visibility="Collapsed"/>
                        <RadioButton x:Name="ITextSharpRadio" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Save"
                    Click="SaveButton_Click"
                    Padding="20,10"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="2"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Padding="20,10"
                    Background="#757575"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
